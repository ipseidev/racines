<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!--
            `force="true"` sur ce que la suite **possède** : sans lui, une
            variable présente dans l'environnement gagne, et l'intégration
            continue faisait tourner les tests avec une autre file et un autre
            cache que la machine du développeur. Vert en local, rouge en CI,
            pour une raison invisible dans le code (T-94).

            Les variables de connexion (`DB_HOST`, `REDIS_HOST`) restent
            libres : chaque environnement a les siennes.
        -->
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="SMS_PROVIDER" value="fake" force="true"/>
        <env name="MEDIA_DRIVER" value="fake" force="true"/>
        <env name="ASR_PROVIDER" value="fake" force="true"/>
        <env name="LLM_PROVIDER" value="fake" force="true"/>
        <env name="STRIPE_DRIVER" value="fake" force="true"/>
        <!-- Épinglée : sinon un tunnel ouvert sur le poste fait échouer tout
             test qui compare une URL (T-177). -->
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="LINKS_DOMAIN" value="localhost" force="true"/>
        <env name="ASR_CALLBACK_SECRET" value="secret-de-test-pour-les-rappels-asr"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <!-- Le rendu serveur est un service : la suite ne se connecte à rien. -->
        <env name="INERTIA_SSR_ENABLED" value="false" force="true"/>
        <!-- Le démon ClamAV n’existe pas en intégration continue. -->
        <env name="ANTIVIRUS_SCANNER" value="fake" force="true"/>
        <!-- Le rendu du BAT : le vrai demande Chromium et cinq minutes. -->
        <env name="PDF_DRIVER" value="fake" force="true"/>
        <!-- Le second facteur du panneau : exigé ici quoi qu'en dise le `.env`
             d'une machine de développement, où il peut être éteint pour que
             les vérifications humaines ne butent pas dessus (T-189). C'est le
             comportement de production que la suite doit décrire. -->
        <env name="ADMIN_2FA" value="true" force="true"/>
        <env name="MEDIA_DISK" value="r2" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
