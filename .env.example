# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Racines
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Domaine court et stable des liens (/r /l /q /i /a /x /n). Doc 04 §9.
LINKS_DOMAIN=localhost

# ── Ports locaux (décalés : 80, 5432, 6379, 1025, 8025 sont pris par d'autres piles) ─
APP_PORT=8001
VITE_PORT=5176
FORWARD_DB_PORT=54323
FORWARD_REDIS_PORT=6381
FORWARD_MAILPIT_PORT=1027
FORWARD_MAILPIT_DASHBOARD_PORT=8027
FORWARD_MINIO_PORT=9001
FORWARD_MINIO_CONSOLE_PORT=8901

# ── Marque (valeurs de repli ; la source de vérité est BrandSettings, bloc 01) ─
BRAND_PRODUCT_NAME=Racines
BRAND_SHORT_NAME=Racines
BRAND_SUPPORT_EMAIL=support@example.test
BRAND_SMS_SENDER_ID=RACINES
BRAND_LEGAL_ENTITY=

# ── Journalisation ────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de données (Postgres) ────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
DB_SSLMODE=prefer

# ── Redis, files, cache, session ──────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
# Bascule vers redis au bloc 05 (Horizon)
# Magasin des drapeaux de fonctionnalité (Pennant) : database ou array
PENNANT_STORE=database

# ── Stockage objet (R2 en production, MinIO en local) ─────────────────────────
FILESYSTEM_DISK=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=sail
R2_SECRET_ACCESS_KEY=password
R2_ENDPOINT=http://minio:9000
R2_BUCKET_MEDIA=media
R2_BUCKET_MEDIA_REPLICA=media-replica
R2_BUCKET_BACKUPS=backups
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_DEFAULT_REGION=auto

# ── Email (Mailpit en local, Resend en production) ────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bonjour@example.test"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ── SMS (bloc 05) ─────────────────────────────────────────────────────────────
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Transcription (bloc 06) ───────────────────────────────────────────────────
ASR_PROVIDER=fake
GLADIA_API_KEY=
DEEPGRAM_API_KEY=
ASR_CALLBACK_SECRET=

# ── Rendu Fluide (bloc 06) ────────────────────────────────────────────────────
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=8000

# ── Paiement (bloc 10) ────────────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PILOT=
STRIPE_PRICE_PREVENTE_99=
STRIPE_PRICE_PREVENTE_129=
STRIPE_PRICE_EXTRA_COPY=
STRIPE_PRICE_PHONE_OPTION=

# ── Observabilité (blocs 15 et 16) ────────────────────────────────────────────
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
FLARE_KEY=
OH_DEAR_HEALTH_CHECK_SECRET=

# ── Compte d'administration semé en local et en test ──────────────────────────
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=password

# ── Outils locaux ─────────────────────────────────────────────────────────────
TELESCOPE_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FFMPEG_BINARIES=/usr/bin/ffmpeg
FFPROBE_BINARIES=/usr/bin/ffprobe
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_CHROME_PATH=

VITE_APP_NAME="${APP_NAME}"
